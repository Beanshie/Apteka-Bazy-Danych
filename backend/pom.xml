<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>
	<groupId>pk.bd</groupId>
	<artifactId>apteka</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name />
	<description />
	<url />
	<licenses>
		<license />
	</licenses>
	<developers>
		<developer />
	</developers>
	<scm>
		<connection />
		<developerConnection />
		<tag />
		<url />
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mariadb</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Walidacja DTO (@Valid, @NotNull) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Adnotacje Jackson (@JsonProperty) -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>

		<!-- Adnotacje Swagger (@Schema, @Operation) -->
		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-annotations</artifactId>
			<version>2.2.20</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>



	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>7.26.0</version>
				<!-- Wspólna konfiguracja dla wszystkich plików -->
				<configuration>
					<generatorName>spring</generatorName>
					<output>${project.build.directory}/generated-sources/openapi</output>
					<cleanupOutput>false</cleanupOutput>
					<addCompileSourceRoot>true</addCompileSourceRoot>
					<apiPackage>pk.bd.apteka.api</apiPackage>
					<modelPackage>pk.bd.apteka.dto</modelPackage>
					<configOptions>
						<interfaceOnly>true</interfaceOnly>
						<containerDefaultToNull>true</containerDefaultToNull>
						<useTags>true</useTags>
						<useSpringBoot3>true</useSpringBoot3>
						<useJakartaJaxb>true</useJakartaJaxb>
						<skipDefaultInterface>true</skipDefaultInterface>
						<openApiNullable>false</openApiNullable>
					</configOptions>
				</configuration>
				<executions>
					<execution>
						<id>generate-klient</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/klient.yaml</inputSpec>
							<!-- Clean once; later executions retain earlier generated sources. -->
							<cleanupOutput>true</cleanupOutput>
						</configuration>
					</execution>
					<execution>
						<id>generate-pracownik</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/pracownik.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-kategoria</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/kategoria.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-dostawca</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/dostawca.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-produkt</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/produkt.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-adres-klienta</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/adres_klienta.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-recepta</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/recepta.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-zamowienie</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/zamowienie.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-szczegol-zamowienia</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/szczegol_zamowienia.yaml</inputSpec>
						</configuration>
					</execution>
					<execution>
						<id>generate-platnosc</id>
						<goals>
							<goal>generate</goal>
						</goals>
						<configuration>
							<inputSpec>${project.basedir}/api/platnosc.yaml</inputSpec>
						</configuration>
					</execution>
				</executions>
			</plugin>
			
		</plugins>
	</build>

</project>
